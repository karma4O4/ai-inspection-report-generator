# FastAPI App Config
PORT=8000
HOST=0.0.0.0

# JWT Auth Secret Key (generate a strong random hex string in production)
JWT_SECRET_KEY=yoursecretkeyherechangeitinproduction123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# OpenAI API Key for GPT-4 Vision and Summarization
OPENAI_API_KEY=sk-proj-yourOpenAiApiKeyHere

# Cloudinary Storage Configuration (or Supabase Storage fallback)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Environment flag
ENVIRONMENT=development
